# fly.io deployment template — copy to fly.toml, set app name, then deploy.
# 中文：复制为 fly.toml 并改 app 名；数据在 volume，密钥用 fly secrets。
app = "tokencoup-outreach-scheduler"   # change to your app name
primary_region = "hkg"                 # pick a region; note OPR IP binding!

[build]
  dockerfile = "Dockerfile"

[env]
  OSCHED_DATA_ROOT = "/data"
  OSCHED_CONFIG = "/data/config/global.yaml"   # config lives on the volume
  PORTAL_BASE_URL = "https://<your-app>.fly.dev"  # verification-mail links + OAuth redirect_uri base
  PORTAL_FRONTEND_URL = "https://<your-spa>/app/"  # OAuth handoff target (one-time code -> SPA)
  PORTAL_ADMIN_EMAILS = "<super-admin@example.com>"  # seeds admin_whitelist at boot
  TZ = "Asia/Shanghai"                # supercronic times follow TZ

# one small VM is plenty (stdlib-only workload, ~no traffic)
[vm]
  size = "shared-cpu-1x"
  memory = "512mb"

# data volume: pool.sqlite3, project YAMLs, templates, secrets-env all live here
[[mounts]]
  source = "osched_data"
  destination = "/data"

# portal HTTP service + cron on the same machine (volume is single-attach)
[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = false     # cron must keep running
  auto_start_machines = true
  processes = ["app"]
  [http_service.concurrency]
    type = "requests"

[processes]
  app = "sh scripts/start.sh"
